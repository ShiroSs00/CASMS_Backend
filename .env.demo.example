# Local Windows demo environment for CASMS (strictly local PostgreSQL, NEVER remote)
# Copy this file to .env.demo and adjust credentials if your local PostgreSQL differs.

DEMO_DB_NAME=casms_demo
DEMO_PG_MODE=docker
DEMO_PG_CONTAINER=casms-postgres
DEMO_PG_HOST=localhost
DEMO_PG_PORT=5432

DB_URL=jdbc:postgresql://localhost:5432/casms_demo?stringtype=unspecified
DB_USERNAME=postgres
DB_PASSWORD=12345

SERVER_PORT=8080
SEPAY_ENABLED=true
