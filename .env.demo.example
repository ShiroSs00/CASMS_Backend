SEPAY_BANK_NAME=MBBank
SEPAY_ACCOUNT_NUMBER=0901452366
SEPAY_ACCOUNT_NAME=CONG TY DU THUYEN CASMS DEMO

WEB_BOOKING_URL=http://localhost:5173
WEB_ADMIN_URL=http://localhost:5174
