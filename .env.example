# ==========================================
# CASMS BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy file này thành .env và điền các giá trị thật trên Server / Local.
# KHÔNG commit file .env chứa mật khẩu thật lên Git / CodeCommit.
# ==========================================

# Database Configuration (PostgreSQL / Supabase)
DB_URL=jdbc:postgresql://<HOST>:5432/<DATABASE_NAME>?stringtype=unspecified
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# JWT Security
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_length
JWT_EXPIRATION_MS=86400000

# SePay Payment Gateway
SEPAY_ENABLED=true
SEPAY_API_KEY=your_sepay_api_key_from_dashboard
SEPAY_BANK_NAME=MBBank
SEPAY_ACCOUNT_NUMBER=your_bank_account_number
SEPAY_ACCOUNT_NAME=YOUR_ACCOUNT_NAME
SEPAY_USD_TO_VND_RATE=25400
SEPAY_QR_TEMPLATE=compact
SEPAY_TOLERANCE_PERCENT=1.0

# Spring Profiles (dev, prod, etc.)
SPRING_PROFILES_ACTIVE=dev

